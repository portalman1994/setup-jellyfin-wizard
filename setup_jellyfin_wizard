is_jellyfin_online() {
  log_msg "Waiting for Jellyfin to come back online..."
  local elapsed
  local max_wait
  elapsed=0
  max_wait=180

  until curl -s "${JELLYFIN_URL}/System/Info/Public" | jq -e '.ProductName' > /dev/null 2>&1; do
    if [ $elapsed -ge $max_wait ]; then
      info "Jellyfin did not come back online after ${max_wait}s"
      exit 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
    log_msg "Still waiting... (${elapsed}s)"
  done
}

confirm_action() {
  local -r title="$1"
  local -r synopsis="$2"
  local msg_proceed
  read -r -d '' msg_proceed << EOF || true
${synopsis}

Do you want to proceed?
EOF
  local _pid _resized _ec
  while true; do
    _resized=0
    whiptail --title "${title}" \
      --yesno "${msg_proceed}" \
      "$(_wt_h)" "$(_wt_w)" >/dev/tty </dev/tty &
    _pid=$!
    trap '_resized=1; kill "${_pid}" 2>/dev/null' SIGWINCH
    wait "${_pid}" && _ec=0 || _ec=$?
    trap - SIGWINCH
    [[ ${_resized} -eq 1 ]] && { sleep 0.15; continue; }
    return "${_ec}"
  done
}

notify_success() {
  local -r title="$1"
  local -r message="$2"
  local _pid _resized _ec
  while true; do
    _resized=0
    whiptail --title "${title} - Success" \
      --msgbox "${message}" "$(_wt_h)" "$(_wt_w)" >/dev/tty </dev/tty &
    _pid=$!
    trap '_resized=1; kill "${_pid}" 2>/dev/null' SIGWINCH
    wait "${_pid}" && _ec=0 || _ec=$?
    trap - SIGWINCH
    [[ ${_resized} -eq 1 ]] && { sleep 0.15; continue; }
    return "${_ec}"
  done
}

notify_skipped() {
  local -r title="$1"
  local _pid _resized _ec
  while true; do
    _resized=0
    whiptail --title "${title} - Skipped" \
      --msgbox "No changes were made." "$(_wt_h)" "$(_wt_w)" >/dev/tty </dev/tty &
    _pid=$!
    trap '_resized=1; kill "${_pid}" 2>/dev/null' SIGWINCH
    wait "${_pid}" && _ec=0 || _ec=$?
    trap - SIGWINCH
    [[ ${_resized} -eq 1 ]] && { sleep 0.15; continue; }
    return "${_ec}"
  done
}

run_task() {
  local -r title="$1"
  local -r msg="$2"
  local -r cond_func="$3"
  local -r action_func="$4"
  shift 4

  if "${cond_func}" "$@"; then
    return 0
  fi

  if ! confirm_action "${title}" "${msg}"; then
    notify_skipped "${title}"
    return 0
  fi

  "${action_func}" "$@"
}

execute_batch_tasks() {
  if [[ "$#" -lt 2 ]]; then
    err "Error: execute_batch_tasks requires at least 2 arguments."
    return 1
  fi

  local -r title="$1"
  local -r synopsis="$2"
  shift 2

  local -r actions=("$@")
  local action_func

  if confirm_action "${title}" "${synopsis}"; then
    if [[ "${#actions[@]}" -eq 0 ]]; then
      whiptail --title "Notice" \
        --msgbox "No actions were selected to run." "$(_wt_h)" "$(_wt_w)"
      return 0
    fi

    whiptail --title "Working" \
      --infobox "Applying batch configurations..." "$(_wt_h)" "$(_wt_w)"

    for action_func in "${actions[@]}"; do
      [[ -z "${action_func}" ]] && continue

      local func_name="${action_func%% *}"
      if declare -f "${func_name}" &>/dev/null; then
        log_msg "Executing batch action: ${action_func}"
        if ! eval "${action_func}"; then
          whiptail --title "Error" \
            --msgbox "Batch process failed while running '${action_func}'." "$(_wt_h)" "$(_wt_w)"
          return 1
        fi
      else
        whiptail --title "Error" \
          --msgbox "Unknown action handler: '${action_func}'" "$(_wt_h)" "$(_wt_w)"
        return 1
      fi
    done

    notify_success "${title}" "All batch configurations applied successfully!"
  else
    notify_skipped "${title}"
  fi

  return 0
}

run_with_progress() {
  local -r title="${1:-}"

  if (( $# > 0 )); then
    shift
  fi

  local -ra tasks=("$@")
  local -r total="${#tasks[@]}"

  if [[ "${total}" -eq 0 ]]; then
    return 0
  fi

  local tmp_exit
  tmp_exit=$(mktemp) || { printf "Failed to create temporary file.\n" >&2; return 1; }

  printf '0' > "${tmp_exit}"

  {
    local i task label cmd pct_start pct_end task_pid p
    for i in "${!tasks[@]}"; do
      task="${tasks[$i]}"
      label="${task%%:*}"
      cmd="${task#*:}"
      pct_start=$(( i * 100 / total ))
      pct_end=$(( (i + 1) * 100 / total ))

      log_msg "Starting Task: ${label}"
      printf 'XXX\n%d\n[%d/%d] %s\nXXX\n' "${pct_start}" "$((i + 1))" "${total}" "${label}"

      ( eval "${cmd}" > /dev/null 2>&1 || printf '1' >"${tmp_exit}" ) &
      task_pid=$!

      p="${pct_start}"
      while kill -0 "${task_pid}" 2>/dev/null; do
        printf '%d\n' "${p}"
        sleep 0.5

        if (( p < pct_end - 1 )); then
          p=$(( p + 1 ))
        fi
      done

      wait "${task_pid}" || true

      if [[ "$(<"${tmp_exit}")" == '1' ]]; then
        log_msg "Failed Task: ${label}"
        printf 'XXX\n%d\nFAILED: %s\nXXX\n' "${pct_end}" "${label}"
        sleep 2
        break
      fi

      log_msg "Completed Task: ${label}"
      printf '%d\n' "${pct_end}"
    done

    if [[ "$(<"${tmp_exit}")" == '0' ]]; then
      printf 'XXX\n100\nDone!\nXXX\n'
      sleep 1
    fi
  } | whiptail --title "${title}" --gauge "Starting..." "${_wt_h}" "${_wt_w}" 0

  local final_exit=1
  if [[ -f "${tmp_exit}" ]]; then
    final_exit="$(<"${tmp_exit}")"
    rm -f "${tmp_exit}"
  fi

  return "${final_exit}"
}

setup_storage() {
  if [[ -L "$HOME/storage/shared" && -d "$HOME/storage/shared" ]]; then
    info "Storage already set up."
    return 0
  fi

  info "Storage not set up. Requesting permission..."
  termux-setup-storage
  sleep 5

  if [[ -L "$HOME/storage/shared" && -d "$HOME/storage/shared" ]]; then
    info "Storage set up successfully."
    return 0
  else
    err "Storage setup failed — did you accept the permission dialog?"
    return 1
  fi
}

get_jellyfin_token() {
  local jellyfin_user=$1
  local jellyfin_password=$2
  local response
  local msg_error
  local payload
  local auth_header
  local client="Jellyfin Setup Wizard"
  local device="Local"
  local device_id="127-0-0-1"
  local version="1.0.0"

  auth_header=$(jq -nr \
  --arg client "$client" \
  --arg device "$device" \
  --arg dev_id "$device_id" \
  --arg ver "$version" \
  '"MediaBrowser Client=\($client), Device=\($device), DeviceId=\($dev_id), Version=\($ver)"')

  payload=$(jq -n \
    --arg user "$jellyfin_user" \
    --arg pass "$jellyfin_password" \
    '{Username: $user, Pw: $pass}')

  read -r -d '' msg_error << EOF || true
Failed to get token. Check your credentials.
EOF

  if response=$(curl -sSL \
    -X POST "${JELLYFIN_URL}/Users/AuthenticateByName" \
    -H "Authorization: ${auth_header}" \
    -H "Content-Type: application/json" \
    -d "${payload}"); then
    log_msg "Token acquired successfully"
  else
    err "${msg_error}"
    return 1
  fi

  local token
  token=$(printf "%s" "$response" | jq -r '.AccessToken // empty')

  if [[ -z "${token}" ]]; then
    err "${msg_error}"
    return 1
  fi

  printf '%s\n' "${token}"
}

generate_auth_file() {
    local token="$1"
    local temp_file

    if ! temp_file=$(mktemp -t jellyfin_auth.XXXXXX); then
        err "Failed to create temporary file."
        return 1
    fi

    chmod 600 "${temp_file}"
    printf 'Authorization: MediaBrowser Token="%s"\n' "${token}" > "${temp_file}"
    printf '%s\n' "$temp_file"
    return 0
}

check_jellyfin_tasks() {
  [[ -f "${SCHEDULED_TASKS_FLAG_FILE}" ]]
}

check_jellyfin_users() {
  local auth_file="$1"
  local all_disabled
  local response

  if response=$(curl -sS \
    -H "@${auth_file}" \
    -H "Content-Type: application/json" \
    -w "\n%{http_code}" \
    "${JELLYFIN_URL}/Users"); then
    log_msg "Retrieved response from /Users"
  else
    err "Failed to reach /Users"
    return 1
  fi
  local users
  users=$(printf "%s" "$response" | head -n -1)
  log_msg "Checking Transcode Policy for last user"

  all_disabled=$(printf "%s" "${users}" | jq '
    [.[-1].Policy |
      .EnableVideoPlaybackTranscoding,
      .EnableAudioPlaybackTranscoding,
      .ForceRemoteSourceTranscoding
    ] | all(. == false)')

  [[ "${all_disabled}" == "true" ]]
}

require_jellyfin_token() {
  local -r feature="$1"
  local auth_file="$2"
  local msg_require
  read -r -d '' msg_require << EOF || true

To access $feature, you must complete the initial setup of Jellyfin,
open this phone's web browser and go to http://localhost:8096 or
your phone's IP address on port 8096.
EOF

  if [[ "${auth_file}" == "0" ]]; then
    whiptail --title "Jellyfin Token Required" \
      --msgbox "${msg_require}" "$(_wt_h)" "$(_wt_w)"
    return 1
  fi
}

action_install_jellyfin() {
  if ! grep -q "DOTNET_ROOT" "$HOME/.bashrc"; then
    cat << EOF >> "$HOME/.bashrc"
export DOTNET_ROOT=$PREFIX/lib/dotnet
export LD_LIBRARY_PATH=$PREFIX/lib
EOF
  fi

  export DOTNET_ROOT=$PREFIX/lib/dotnet
  export LD_LIBRARY_PATH=$PREFIX/lib

  run_with_progress 'Installing Jellyfin' \
    'Optimizing Jellyfin Configuration:_task_optimize_jellyfin' \
    'Updating package list:_task_pkg_update' \
    'Upgrading system:_task_pkg_upgrade' \
    'Installing Jellyfin Media Server:_task_install_jellyfin_deps' \
    'Creating Boot Script:_task_create_jellyfin_autostart'
}

action_install_dependencies() {
  if are_termux_deps_installed; then
    return 0
  fi

  local missing_packages
  missing_packages=()

  if ! is_whiptail_installed; then
    missing_packages+=("whiptail")
  fi

  if ! is_openssh_installed; then
    missing_packages+=("openssh")
  fi

  if ! is_ncurses_installed; then
    missing_packages+=("ncurses-utils")
  fi

  if ! is_jq_installed; then
    missing_packages+=("jq")
  fi

  if [[ ${#missing_packages[@]} -gt 0 ]]; then
    printf "Missing packages to install: %s\n" "${missing_packages[*]}"
    _task_install_script_deps "${missing_packages[@]}" || return 1

    mkdir -p "$HOME/.termux/boot/"
    _task_create_termux_autostart || return 1
    _task_create_openssh_autostart || return 1

    mkdir -p "${PROVISION_DIR}"
    touch "${DEPS_FLAG_FILE}"
  fi
}

action_setup_dlna() {
  local -r auth_file="$1"
  run_with_progress 'Installing DLNA Plugin' \
    "Installing DLNA Plugin:action_install_dlna '${auth_file}'" \
    "Restarting Jellyfin:action_restart_jellyfin '${auth_file}'" \
    'Starting Jellyfin:is_jellyfin_online' \
    "Verifying Installation:is_dlna_installed '${auth_file}'"
}

action_restart_jellyfin() {
  local auth_file="$1"
  local response

  response=$(curl -fsSL \
    -X POST \
    -H "@${auth_file}" \
    -H "Content-Type: application/json" \
    "${JELLYFIN_URL}/System/Restart")

  log_msg "${response}"
}

action_install_dlna() {
  local auth_file="$1"
  local response

  response=$(curl -fsSL \
    -X POST \
    -H "@${auth_file}" \
    -H "Content-Type: application/json" \
    "${JELLYFIN_URL}/Packages/Installed/DLNA")
  log_msg "${response}"
}

action_configure_transcoder() {
  local auth_file="$1"
  local users
  local users_ids

  if users=$(curl -fsSL \
    -H "@${auth_file}" \
    -H "Content-Type: application/json" \
    "${JELLYFIN_URL}/Users"); then
    log_msg "Retrieved response from /Users"
  else
    err "Failed to reach /Users"
    return 1
  fi

  users_ids=$(printf "%s" "${users}" \
    | jq -r '.[].Id')

  for user_id in $users_ids; do
    local user
    user=$(curl -fsSL \
      -H "@${auth_file}" \
      -H "Content-Type: application/json" \
      "${JELLYFIN_URL}/Users/${user_id}")

    local trancode_policy
    trancode_policy=$(printf "%s" "${user}" \
      | jq '.Policy |
      .EnableVideoPlaybackTranscoding = false |
      .EnableAudioPlaybackTranscoding = false |
      .ForceRemoteSourceTranscoding   = false')

    local response
    if response=$(curl -fsSL \
      -X POST \
      -H "@${auth_file}" \
      -H "Content-Type: application/json" \
      -d "${trancode_policy}" \
      "${JELLYFIN_URL}/Users/${user_id}/Policy"); then
      log_msg "Disabled transcoding for ${user_id}"
    else
      err "Unable to disable transcoding for ${user_id}"
      return 1
    fi
  done
}

action_configure_tasks() {
  local auth_file="$1"
  local tasks
  local task_id
  local check_task
  local current

  local -a tasks_to_disable

  if tasks=$(curl -fsSL \
    -H "@${auth_file}" \
    -H "Content-Type: application/json" \
    "${JELLYFIN_URL}/ScheduledTasks"); then
    log_msg "Retreived scheduled tasks"
  else
    err "Unable to reach /ScheduledTasks"
    return 1
  fi

  if printf "%s" "${tasks}" | grep -q "Unauthorized"; then
    err "Unauthorized: API Key (Not Admin)"
    return 1
  fi

  tasks_to_disable=(
    "Audio Normalization"
    "Clean Activity Log"
    "Clean Cache Directory"
    "Clean Log Directory"
    "Clean Transcode Directory"
    "Clean up collections and playlists"
    "Download missing lyrics"
    "Download missing subtitles"
    "Extract Chapter Images"
    "Generate Trickplay Images"
    "Keyframe Extractor"
    "Media Segment Scan"
    "Migrate Trickplay Image Location"
    "Optimize database"
    "Refresh People"
    "Scan Media Library"
    "Update Plugins"
    "User data cleanup task"
  )


  declare -A tasks_to_enable=(
    ["Scan Media Library"]='[{"Type":"StartupTrigger"}]'
    ["Clean Transcode Directory"]='[{"Type":"WeeklyTrigger", "TimeOfDayTicks":0, "DayOfWeek":"Monday"}]'
    ["Clean Cache Directory"]='[{"Type":"WeeklyTrigger", "TimeOfDayTicks":0, "DayOfWeek":"Tuesday"}]'
    ["Clean Log Directory"]='[{"Type":"WeeklyTrigger", "TimeOfDayTicks":0, "DayOfWeek":"Wednesday"}]'
    ["Optimize database"]='[{"Type":"IntervalTrigger", "IntervalTicks":25920000000000}]'
  )

  for task_name in "${tasks_to_disable[@]}"; do
    task_id=$(printf "%s" "$tasks" | \
      jq -r --arg name "$task_name" '.[] | select(.Name == $name) | .Id')

    if [[ -z "${task_id}" ]]; then
      log_msg "'${task_name}' — task not found"
      continue
    fi

    local disabled_response
    if disabled_response=$(curl -fsSL \
      -X POST \
      -H "@${auth_file}" \
      -H "Content-Type: application/json" \
      -d '[]' \
      "${JELLYFIN_URL}/ScheduledTasks/${task_id}/Triggers"); then
      log_msg "Requested ${task_id} to be disabled"
    fi

    check_task=$(curl -fsSL \
      -H "@${auth_file}" \
      "${JELLYFIN_URL}/ScheduledTasks/${task_id}")

    current=$(printf "%s" "${check_task}" \
      | jq '.Triggers | length')
    if [[ "${current}" == "0" ]]; then
      log_msg "'${task_name}' - disabled"
    else
      err "'${task_name}' - still enabled"
      return 1
    fi
  done

  log_msg "Configuring Scheduled Tasks"

  for task_name in "${!tasks_to_enable[@]}"; do
    task_id=$(printf "%s" "$tasks" | \
      jq -r --arg name "$task_name" '.[] | select(.Name == $name) | .Id')

    if [[ -z "${task_id}" ]]; then
      log_msg "'${task_name}' — task not found"
      continue
    fi

    local payload="${tasks_to_enable[$task_name]}"

    local enabled_response
    if enabled_response=$(curl -fsSL \
      -X POST \
      -H "@${auth_file}" \
      -H "Content-Type: application/json" \
      -d "${payload}" \
      "${JELLYFIN_URL}/ScheduledTasks/${task_id}/Triggers" > /dev/null); then
      log_msg "${task_name} configured successfully"
    else
      err "Failed to configure '${task_name}'"
      return 1
    fi
  done

  mkdir -p "${PROVISION_DIR}"
  touch "${SCHEDULED_TASKS_FLAG_FILE}"
}

