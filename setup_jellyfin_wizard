# MAIN MENU & MAIN FUNCTION
# ==============================================================================

show_main_menu() {
  local auth_file="$1"
  local choice

  while true; do
    if ! choice=$(show_menu "Jellyfin Setup Wizard" "Select a module to configure:" \
      "1" "Create Media Folders" \
      "2" "Install Jellyfin" \
      "3" "Create Media Libraries" \
      "4" "Configure Jellyfin Settings" \
      "5" "Exit Wizard"); then
      break
    fi

    case "${choice}" in
      1) submenu_create_media_folders ;;
      2) submenu_install_jellyfin ;;
      3) submenu_create_media_libraries "${auth_file}" ;;
      4) submenu_configure_jellyfin_settings "${auth_file}" ;;
      5) break ;;
      *) break ;;
    esac
  done
}

main() {
  local auth_file
  local ip_address
  mkdir -p "${APP_DIR}" || { printf 'ERROR: Could not create %s\n' "${APP_DIR}" >&2; exit 1; }

  ip_address=$(ifconfig 2>/dev/null \
    | awk '/^wlan0/{f=1} f && /inet /{print $2; exit} /^$/{f=0}')


  log_msg "=== Setup Jellyfin Wizard Session Started ==="

  local msg_deps
  read -r -d '' msg_deps << EOF || true
ERROR: Failed to install initial script dependencies.
EOF

  if ! action_install_dependencies; then
    printf '%s\n' "${msg_deps}"
    exit 1
  fi

  if is_jellyfin_installed; then
    local setup_status
    setup_status=$(curl -fsSL \
    "$JELLYFIN_URL/System/Info/Public" \
    | jq -r '.StartupWizardCompleted // "unknown"') || setup_status="unknown"

    if [[ "${setup_status}" == "true" ]]; then
      info "Jellyfin is configured. An admin account exists."
      local username
      local password
      local token

      if ! username=$(whiptail --title "Generate Temporary Token" \
        --inputbox "Enter Jellyfin Username:" "$(_wt_h)" "$(_wt_w)" \
        3>&1 1>&2 2>&3) || [[ -z "${username}" ]]; then
        return 1
      fi

      if ! password=$(whiptail --title "Generate Temporary Token" \
        --passwordbox "Enter Jellyfin Password:" "$(_wt_h)" "$(_wt_w)" \
        3>&1 1>&2 2>&3) || [[ -z "${password}" ]]; then
        return 1
      fi

      if ! token=$(get_jellyfin_token "$username" "$password"); then
        err "Could not acquire jellyfin token."
        return 1
      fi

      auth_file=$(generate_auth_file "${token}")
      trap 'rm -f "${auth_file}"' EXIT
      show_main_menu "${auth_file}"
    elif [[ "${setup_status}" == "false" ]]; then
      info "Jellyfin is unconfigured. An admin account is absent."
      auth_file="0"
      show_main_menu "${auth_file}"
    else
      info "Could not reach Jellyfin or received an invalid response."
      auth_file="0"
      show_main_menu "${auth_file}"
    fi
  else
    auth_file="0"
    show_main_menu "${auth_file}"
  fi

  clear
  info "Setup wizard closed."
  if [ -z "${ip_address}" ]; then
    info "Could not find IP address"
  else
    info "IP address: ${ip_address}"
  fi

  log_msg "=== Setup Jellyfin Wizard Session Closed ==="
  return 0
}

