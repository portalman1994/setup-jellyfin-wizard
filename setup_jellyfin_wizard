readonly JELLYFIN_URL="http://127.0.0.1:8096"
readonly LIBRARY_LANGUAGE="eng"
readonly LIBRARY_COUNTRY="US"

readonly APP_DIR="$PREFIX/var/lib/setup_jellyfin_wizard"
readonly LOG_FILE="${APP_DIR}/media_server_setup.log"
readonly PROVISION_DIR="${APP_DIR}/flag_files"
readonly DEPS_FLAG_FILE="${PROVISION_DIR}/.deps_installed"
readonly CREATED_TV_FLAG_FILE="${PROVISION_DIR}/.tv_library_created"
readonly CREATED_MOVIE_FLAG_FILE="${PROVISION_DIR}/.movie_library_created"
