}

is_ncurses_installed() {
  command -v tput &>/dev/null
}

is_jq_installed() {
  command -v jq &>/dev/null
}

is_jellyfin_installed() {
  command -v jellyfin &>/dev/null
}

is_dlna_installed() {
  local auth_file="$1"
  local response
  response=$(curl -s \
    -H "@${auth_file}" \
    "${JELLYFIN_URL}/Plugins" \
    | jq -r '.[] | select(.Name == "DLNA") | .Name')

  if [[ "${response}" == "DLNA" ]]; then
    return 0
  else
    return 1
  fi
}

