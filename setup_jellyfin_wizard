action_create_media_library() {
  local -r name="$1"
  local -r auth_file="$2"
  local type
  local location
  local -r language="${LIBRARY_LANGUAGE}"
  local -r country="${LIBRARY_COUNTRY}"
  local payload
  local sd_card_id

  sd_card_id=$(detect_sd_card)
  local base_dir="/storage/$sd_card_id/"
  case "${name}" in
    "${MOVIES_NAME}")
      type="${MOVIES_TYPE}"
      location="${base_dir}${TERMUX_DIR}/${MOVIES_DIR}"
      ;;
    "${SHOWS_NAME}")
      type="${SHOWS_TYPE}"
      location="${base_dir}${TERMUX_DIR}/${SHOWS_DIR}"
      ;;
    *)
      err "Unknown library name: '${name}'."
      return 1
      ;;
  esac

  payload=$(jq -n \
    --arg lang "${language}" \
    --arg country "${country}" \
    --arg path "${location}" \
    '{
      LibraryOptions: {
        PreferredMetadataLanguage: $lang,
        MetadataCountryCode: $country,
        EnableRealtimeMonitor: false,
        MetadataSavers: [],
        LocalMetadataReaderOrder: [],
        SubtitleDownloadLanguages: [],
        TypeOptions: [],
        PathInfos: [{ Path: $path }]
      }
    }')

  local msg_error

  read -r -d '' msg_error << EOF || true
Failed to create library ${name}.
EOF

  local enc_name
  local enc_type
  local enc_loc
  enc_name=$(printf '%s' "${name}" | jq -sRr @uri)
  enc_type=$(printf '%s' "${type}" | jq -sRr @uri)
  enc_loc=$(printf '%s' "${location}" | jq -sRr @uri)


  local api_url
  api_url="${JELLYFIN_URL}/Library/VirtualFolders"
  api_url+="?name=${enc_name}"
  api_url+="&collectionType=${enc_type}"
  api_url+="&paths=${enc_loc}"
  api_url+="&refreshLibrary=false"

  local response
  local http_code
  response=$(curl -sSL \
    -X POST \
    -H "@${auth_file}" \
    -H "Content-Type: application/json" \
    -d "${payload}" \
    -w "\n%{http_code}" \
    "${api_url}")
  http_code=$(tail -n1 <<< "${response}")
  response=$(head -n-1 <<< "${response}")

  if [[ ! "${http_code}" =~ ^2 ]]; then
    err "Failed to create ${name}: HTTP ${http_code} — ${response}"
    return 1
  fi

  log_msg "Library ${name} created (HTTP ${http_code})"

  mkdir -p "${PROVISION_DIR}"
  if [[ "${name}" == "${SHOWS_NAME}" ]]; then
    touch "${CREATED_TV_FLAG_FILE}"
  else
    touch "${CREATED_MOVIE_FLAG_FILE}"
  fi

  local target_dir
  target_dir="${base_dir}${TERMUX_DIR}/media"
  local symlink_dir
  symlink_dir="$HOME/media"
  if [[ ! -e "${symlink_dir}" ]]; then
    ln -s "${target_dir}" "${symlink_dir}"
    log_msg "Created symlink successfully"
  else
    log_msg "Symlink or directory already exists"
  fi
}

action_create_movies_library() {
  action_create_media_library "${MOVIES_NAME}" "$1"
}

action_create_shows_library() {
  action_create_media_library "${SHOWS_NAME}" "$1"
}

# ==============================================================================
# SUBMENU HANDLERS
# ==============================================================================

show_menu() {
  local -r title="$1"
  local -r prompt="$2"
  shift 2

  local _tmp _pid _resized _ec _result
  _tmp=$(mktemp) || return 1

  while true; do
    _resized=0
    whiptail --title "${title}" \
      --menu "${prompt}" \
      "$(_wt_h)" "$(_wt_w)" "$(_wt_lh)" \
      "$@" 2>"${_tmp}" >/dev/tty </dev/tty &
    _pid=$!
    trap '_resized=1; kill "${_pid}" 2>/dev/null' SIGWINCH
    wait "${_pid}" && _ec=0 || _ec=$?
    trap - SIGWINCH
    [[ ${_resized} -eq 1 ]] && { sleep 0.15; continue; }
    _result=$(<"${_tmp}")
    rm -f "${_tmp}"
    printf '%s' "${_result}"
    return "${_ec}"
  done
  rm -f "${_tmp}"
}

