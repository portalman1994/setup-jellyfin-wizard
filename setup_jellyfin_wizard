# ==============================================================================
# TERMUX-AWARE SIZING
# Uses tput (reads kernel TIOCGWINSZ) so values are correct after rotation.
# ==============================================================================
_wt_h()  { local l; l=$(tput lines 2>/dev/null || echo 24);
            printf '%d' $(( l > 14 ? l - 4 : 10 )); }
_wt_w()  { local c; c=$(tput cols  2>/dev/null || echo 80);
            printf '%d' $(( c > 48 ? c - 4 : 44 )); }
_wt_lh() { local h; h=$(_wt_h);
            printf '%d' $(( h > 12 ? h - 8 : 4  )); }

# ==============================================================================
# STATE & HELPER FUNCTIONS
# ==============================================================================

detect_sd_card() {
  local sd_card_id
  sd_card_id=$(df -h | grep -oP '/storage/[A-F0-9]{4}-[A-F0-9]{4}' | cut -d'/' -f3)
  if [[ -z "${sd_card_id}" ]]; then
    printf "emulated/0"
    return 0
  fi
  printf "%s" "$sd_card_id"
}

_task_pkg_update() {
  pkg update -y -qq
}

_task_pkg_upgrade() {
  pkg upgrade -y -o Dpkg::Options::="--force-confold"
}

_task_optimize_jellyfin() {
  local mem_limit
  mem_limit=$(awk '
    /MemAvailable:/ {avail=$2}
    /Buffers:/      {buff=$2}
    END { if (avail) printf "%X", (avail - buff) * 1024 }
  ' /proc/meminfo)
  if ! grep -Fxq "export DOTNET_gcServer=0" "$HOME/.bashrc"; then
    cat << EOF >> "$HOME/.bashrc"
export DOTNET_gcServer=0
export DOTNET_GCHeapHardLimit=$mem_limit
export JELLYFIN_WEB_DIR=$PREFIX/lib/jellyfin/jellyfin-web
export JELLYFIN_CACHE_DIR=$PREFIX/var/cache/jellyfin
export JELLYFIN_DATA_DIR=$PREFIX/var/lib/jellyfin
export JELLYFIN_LOG_DIR=$PREFIX/var/log/jellyfin
EOF
  fi

  chmod +x "$HOME/.bashrc"
}

_task_install_script_deps() {
  local -a pkgs_to_install=("$@")

  if [[ "${#pkgs_to_install[@]}" -eq 0 ]]; then
    printf '%s\n'  "No packages provided to install."
    return 0
  fi

  printf "The following tools need to be installed with apt: %s\n" "${pkgs_to_install[*]}"
  read -r -p "Proceed with installation? [y/N]: " response

  if [[ "${response}" =~ ^[yY]([eE][sS])?$ ]]; then
    printf "Running: pkg update -y\n"
    _task_pkg_update || return 1
    printf "Running: pkg install -y %s\n" "${pkgs_to_install[*]}"
    pkg install -y -qq "${pkgs_to_install[@]}" || return 1
  else
    printf '\nInstallation canceled.\n'
    return 1
  fi
}

_task_install_jellyfin_deps() {
  pkg install -y tur-repo
  pkg update -y
  pkg install -y ffmpeg dotnet-runtime-9.0 jellyfin-server

  grep -qxF 'export PATH="/data/data/com.termux/files/usr/bin:$PATH"' "$HOME/.bashrc" || \
  cat << 'EOF' >> "$HOME/.bashrc"
export PATH="/data/data/com.termux/files/usr/bin:$PATH"
EOF
}

_task_create_termux_autostart() {
  cat << 'EOF' > "$HOME/.termux/boot/00-start-wakelock.sh"
#!/data/data/com.termux/files/usr/bin/bash
termux-wake-lock
EOF

  chmod +x "$HOME/.termux/boot/00-start-wakelock.sh"

  grep -qxF "bash $HOME/.termux/boot/00-start-wakelock.sh" "$HOME/.bashrc" || \
    echo "bash $HOME/.termux/boot/00-start-wakelock.sh" >> "$HOME/.bashrc"
}

_task_create_openssh_autostart() {
  cat << 'EOF' > "$HOME/.termux/boot/01-start-openssh.sh"
#!/data/data/com.termux/files/usr/bin/bash
sshd &
EOF
  chmod +x "$HOME/.termux/boot/01-start-openssh.sh"

  grep -qxF "bash $HOME/.termux/boot/01-start-openssh.sh" "$HOME/.bashrc" || \
    echo "bash $HOME/.termux/boot/01-start-openssh.sh" >> "$HOME/.bashrc"
}

_task_create_jellyfin_autostart() {
  local sd_card_id
  sd_card_id=$(detect_sd_card)
  cat << EOF > "$HOME/.termux/boot/02-start-jellyfin.sh"
#!/data/data/com.termux/files/usr/bin/bash
if [ -d "/storage/$sd_card_id/$TERMUX_DIR/media" ]; then
  chmod -R 755 "/storage/$sd_card_id/$TERMUX_DIR/media"

fi
nohup jellyfin > /dev/null 2>&1 &
EOF
  chmod +x "$HOME/.termux/boot/02-start-jellyfin.sh"

  grep -qxF "bash $HOME/.termux/boot/02-start-jellyfin.sh" "$HOME/.bashrc" || \
    echo "bash $HOME/.termux/boot/02-start-jellyfin.sh" >> "$HOME/.bashrc"
}

log_msg() {
  printf "%s - %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${LOG_FILE}"
}

err() {
  local -r msg="$*"
  printf 'ERROR: %s\n' "${msg}" >&2
  log_msg "ERROR: ${msg}"

  if [[ -t 1 ]] && is_whiptail_installed; then
    whiptail --title " Error " --msgbox "${msg}" "$(_wt_h)" "$(_wt_w)"
  fi
}

info() {
  local -r msg="$*"
  printf 'INFO: %s\n' "${msg}" >&2
  log_msg "INFO: ${msg}"

  if [[ -t 1 ]] && is_whiptail_installed; then
    whiptail --title " Information " --msgbox "${msg}" "$(_wt_h)" "$(_wt_w)"
  fi
}

