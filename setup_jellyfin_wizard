  local msg_transcoder
  local -r title_tasks="Scheduled Tasks Settings"
  local msg_tasks
  local -r title_dlna="Install DLNA Plugin"
  local msg_dlna
  local -r title_all="Apply All Jellyfin Configurations"
  local msg_all

  read -r -d '' msg_transcoder << EOF || true
Configures Video & Audio Playback
Transcoding, and Video Playback Remuxing.
EOF

  read -r -d '' msg_tasks << EOF || true
Configures the following:
"Audio Normalization",
"Download Missing Lyrics",
"Download Missing Subtitles",
"Extract Chapter Images",
"Generate Trickplay",
"Keyframe",
"Media Scan Segment",
"Refresh People",
"Migrate Trickplay"
EOF

  read -r -d '' msg_dlna << EOF || true
Installs DLNA Plugin for Jellyfin.
Restarts Jellyfin to finalize Plugin
installation.
EOF

  read -r -d '' msg_all << EOF || true
This will configure the following:
  1. Scheduled Tasks Settings
  2. Transcoder Policies
  3. DLNA Plugin
EOF

  local s_trans
  local s_tasks
  local s_dlna
  local trans_ok
  local tasks_ok
  local dlna_ok
  local choice
  local -a pending_tasks

  while true; do
    check_jellyfin_tasks "${auth_file}" \
      && tasks_ok=1 || tasks_ok=0
    check_jellyfin_users "${auth_file}" \
      && trans_ok=1 || trans_ok=0
    is_dlna_installed "${auth_file}" \
      && dlna_ok=1 || dlna_ok=0
    s_tasks="[ ]"
      [[ "${tasks_ok}" -eq 1 ]] && s_tasks="[X]"
    s_trans="[ ]"
      [[ "${trans_ok}" -eq 1 ]] && s_trans="[X]"
    s_dlna="[ ]"
      [[ "${dlna_ok}" -eq 1 ]] && s_dlna="[X]"

    pending_tasks=()
      [[ "${tasks_ok}" -eq 0 ]] && pending_tasks+=("action_configure_tasks ${auth_file}")
      [[ "${trans_ok}" -eq 0 ]] && pending_tasks+=("action_configure_transcoder ${auth_file}")
      [[ "${dlna_ok}" -eq 0 ]] && pending_tasks+=("action_setup_dlna ${auth_file}")

    if ! choice="$(show_menu "Configure Jellyfin Settings" "Select an option:" \
      "1" "${s_tasks} ${title_tasks}" \
      "2" "${s_trans} ${title_transcoder}" \
      "3" "${s_dlna} ${title_dlna}" \
      "4" "${title_all}" \
