        if [[ "${#pending_tasks[@]}" -eq 0 ]]; then
          whiptail --title "Already Configured" \
            --msgbox "All Jellyfin settings are already configured!" "$(_wt_h)" "$(_wt_w)"
        else
          execute_batch_tasks "${title_all}" "${msg_all}" "${pending_tasks[@]}"
        fi
        ;;
      5) break ;;
      *) break ;;
    esac
  done
}

